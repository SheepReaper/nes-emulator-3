<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\lib\emulation\Sheep.Emulation.Nes.csproj" />
    <ProjectReference Include="..\..\src\tools\nes-lab-contracts\Sheep.Nes.Lab.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\tools\nes-lab\TraceArtifactFactory.cs" Link="TraceArtifactFactory.cs" />
    <None Include="test-roms.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
